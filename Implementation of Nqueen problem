#include <stdio.h>

#define MAX 20

int board[MAX];

// Function to print the chessboard configuration
void printSolution(int n) {
    printf("\nSolution:\n");
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            if (board[i] == j)
                printf(" Q ");
            else
                printf(" - ");
        }
        printf("\n");
    }
}

// Function to check whether placing a queen at board[row] is safe
int place(int row, int column) {
    for (int i = 1; i <= row - 1; i++) {
        // Check column and diagonal conflicts
        if (board[i] == column || abs(board[i] - column) == abs(i - row))
            return 0;
    }
    return 1;
}

// Recursive function to solve N-Queen problem using backtracking
void NQueen(int row, int n) {
    for (int column = 1; column <= n; column++) {
        if (place(row, column)) {
            board[row] = column;
            if (row == n) {
                printSolution(n);
            } else {
                NQueen(row + 1, n);
            }
        }
    }
}
