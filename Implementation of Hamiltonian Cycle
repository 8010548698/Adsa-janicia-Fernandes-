#include <stdio.h>

#define V 20   // Maximum number of vertices

int path[V];  // Stores the Hamiltonian cycle path

// Function to check if vertex v can be added to the current Hamiltonian Cycle
int isSafe(int v, int graph[V][V], int path[], int pos, int n) {
    // Check if this vertex is adjacent to the previous vertex in the path
    if (graph[path[pos - 1]][v] == 0)
        return 0;

    // Check if the vertex has already been included
    for (int i = 0; i < pos; i++)
        if (path[i] == v)
            return 0;

    return 1;
}

// Recursive function to solve Hamiltonian Cycle problem
int hamiltonianCycleUtil(int graph[V][V], int path[], int pos, int n) {
    // Base case: if all vertices are included in the path
    if (pos == n) {
        // Check if last vertex connects to the first vertex
        if (graph[path[pos - 1]][path[0]] == 1)
            return 1;
        else
            return 0;
    }

    // Try different vertices as next candidates
    for (int v = 1; v < n; v++) {
        if (isSafe(v, graph, path, pos, n)) {
            path[pos] = v;

            if (hamiltonianCycleUtil(graph, path, pos + 1, n) == 1)
                return 1;

            // Backtrack
            path[pos] = -1;
        }
    }

    return 0;
}

// Function to solve Hamiltonian Cycle problem
int hamiltonianCycle(int graph[V][V], int n) {
    // Initialize path[]
    for (int i = 0; i < n; i++)
        path[i] = -1;

    // Start from vertex 0
    path[0] = 0;

    if (hamiltonianCycleUtil(graph, path, 1, n) == 0) {
        printf("\nNo Hamiltonian Cycle exists.\n");
        return 0;
    }

    printf("\nHamiltonian Cycle found:\n");
    for (int i = 0; i < n; i++)
        printf(" %d ->", path[i]);
    printf(" %d\n", path[0]); // complete the cycle

    return 1;
}

int main() {
    int n;
    int graph[V][V];

    printf("Enter the number of vertices: ");
    scanf("%d", &n);

    printf("Enter the adjacency matrix (use 0 for no edge, 1 for edge):\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    hamiltonianCycle(graph, n);

    return 0;
}
